# Fresh Fetch - Firebase Configuration Template
# Create a free Firebase project at: https://console.firebase.google.com/
# Add a Web App, enable Firestore & Phone Auth, and copy your config values below:

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=fresh-fetch-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fresh-fetch-app
VITE_FIREBASE_STORAGE_BUCKET=fresh-fetch-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id_here
